; KDE Classic Cursors
; Right click on the file INSTALL.inf and select "Install". Then apply KDE Classic in Control Panel > Mouse > Pointers.

[Version]
Signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%arrow%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%appstarting%,%10%\%CUR_DIR%\%wait%,%10%\%CUR_DIR%\%crosshair%,%10%\%CUR_DIR%\%ibeam%,%10%\%CUR_DIR%\%nwpen%,%10%\%CUR_DIR%\%no%,%10%\%CUR_DIR%\%sizens%,%10%\%CUR_DIR%\%sizewe%,%10%\%CUR_DIR%\%sizenwse%,%10%\%CUR_DIR%\%sizenesw%,%10%\%CUR_DIR%\%sizeall%,%10%\%CUR_DIR%\%uparrow%,%10%\%CUR_DIR%\%hand%,%10%\%CUR_DIR%\%pin%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
alias.cur
all-scroll.cur
bottom_left_corner.cur
bottom_right_corner.cur
bottom_side.cur
cell.cur
center_ptr.cur
col-resize.cur
context-menu.cur
copy.cur
cross.cur
crosshair.cur
default.cur
dnd-move.cur
dnd-no-drop.cur
down-arrow.cur
fleur.cur
help.cur
left-arrow.cur
left.cur
left_ptr.cur
left_side.cur
no-drop.cur
not-allowed.cur
openhand.cur
pirate.cur
pointer.cur
progress.cur
right-arrow.cur
right_ptr.cur
right_side.cur
row-resize.cur
size_bdiag.cur
size_fdiag.cur
size_hor.cur
size_ver.cur
text.cur
top_left_corner.cur
top_right_corner.cur
top_side.cur
up-arrow.cur
vertical-text.cur
wait.cur
watch.cur
wayland-cursor.cur
x-cursor.cur
zoom-in.cur
zoom-out.cur

[Strings]
CUR_DIR       = "Cursors\KDE-Classic"
SCHEME_NAME   = "KDE Classic"
arrow         = "default.cur"
help          = "help.cur"
appstarting   = "progress.cur"
wait          = "wait.cur"
crosshair     = "crosshair.cur"
ibeam         = "text.cur"
no            = "not-allowed.cur"
sizens        = "size_ver.cur"
sizewe        = "size_hor.cur"
sizenwse      = "size_fdiag.cur"
sizenesw      = "size_bdiag.cur"
sizeall       = "fleur.cur"
uparrow       = "up-arrow.cur"
hand          = "pointer.cur"
nwpen         = "crosshair.cur"
pin           = "pointer.cur"
person        = "pointer.cur"
